# Force LF for all source files — protects from Git Bash on Windows
# silently converting newlines and breaking shell scripts / build files.

* text=auto eol=lf

# Explicit source types.
*.rs        text eol=lf
*.toml      text eol=lf
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.proto     text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.target    text eol=lf
*.socket    text eol=lf
*.path      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary blobs — never touch.
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.gz        binary
*.tar       binary
*.zip       binary
*.bin       binary
*.img       binary
*.so        binary
*.so.*      binary
*.a         binary
*.dylib     binary
*.dll       binary
*.exe       binary
*.eot       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
