# ACM-UZ on-module management agent.
#
# Runs on Smart SFP ISM4120I, pinned to core 0 (cryptod uses core 1).
# Talks to cryptod over UDS, to the central controller over gRPC+mTLS,
# and exposes local web UI / REST / SNMP / Prometheus / syslog.

[Unit]
Description=ACM-UZ management agent
Documentation=https://github.com/zolotaevdmitriy-droid/smartsfp
After=network-online.target acm-cryptod.service
Wants=network-online.target
Requires=acm-cryptod.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s

# Dedicated unprivileged user (created via post-install of OTA package).
User=acm
Group=acm

ExecStart=/usr/local/bin/acm-agent --config /etc/acm/agent.yaml
ExecStop=/bin/kill -SIGTERM $MAINPID

Restart=on-failure
RestartSec=3s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Only need to bind low ports (443 for web UI / REST, 161 for SNMP).
# No raw network, no IO capabilities.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Memory: agent + embedded Svelte UI + a few WebSocket clients.
MemoryHigh=200M
MemoryMax=256M
MemoryAccounting=yes
TasksMax=100

# Pin to core 0 — leave core 1 entirely for cryptod's hot loop.
CPUAffinity=0
CPUAccounting=yes
CPUWeight=100

# Strict filesystem isolation.
ProtectSystem=strict
ReadWritePaths=/var/lib/acm /run/acm
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Logging.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acm-agent

[Install]
WantedBy=multi-user.target
